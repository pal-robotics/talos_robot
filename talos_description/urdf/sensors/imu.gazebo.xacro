<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="imu_sensor_gazebo" params="update_rate">

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>${update_rate}</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <imu>
          <noise>
            <type>gaussian</type>
            <rate>
              <mean>0.0</mean>
              <stddev>0.0</stddev>
              <bias_mean>0.000000</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </rate>
            <accel>
              <mean>0.0</mean>
              <stddev>0.0</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.000</bias_stddev>
            </accel>
          </noise>
        </imu>
        <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
          <topicName>imu</topicName>
          <bodyName>imu_link</bodyName>
          <updateRateHZ>10.0</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
          <frameName>imu_link</frameName>
          <initialOrientationAsReference>false</initialOrientationAsReference>
        </plugin>
      </sensor>
    </gazebo>
    <gazebo reference="imu_joint">
      <!--
        Prevent Gazebo from lumping fixed joints during URDF-to-SDF conversion.

        By default, Gazebo merges links connected by fixed joints to optimize simulation.
        However, this can cause named links like 'imu_link' to disappear from the final model,
        and their associated sensors to be incorrectly attached to parent links (e.g., 'torso_2_link').

        Disabling fixed joint lumping ensures that all links and their sensors are preserved as defined,
        allowing accurate frame references, TF publishing, and sensor data attribution.
      -->
      <preserveFixedJoint>true</preserveFixedJoint>
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>
  </xacro:macro>
</robot>